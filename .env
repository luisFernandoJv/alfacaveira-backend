# Aplicação
APP_NAME="Foco Policial API"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Banco de dados — Supabase usado apenas como Postgres gerenciado (sem Auth/RLS).
# Localmente aponta para o serviço `db` do docker-compose.
DATABASE_URL=postgresql+asyncpg://postgres:3870Lf3870.@db.uqqnwunzllnozmbfalip.supabase.co:5432/postgres
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0

# Segurança / JWT — gerar um valor forte em produção (nunca commitar o real).
JWT_SECRET_KEY=changeme-generate-a-strong-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS — origens do frontend Next.js
CORS_ORIGINS=["http://localhost:3000"]

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
