# Aplicação
APP_NAME="Foco Policial API"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Banco de dados — Supabase usado apenas como Postgres gerenciado (sem Auth/RLS).
# Localmente aponta para o serviço `db` do docker-compose.
# 🔧 CORREÇÃO (auditoria — achado de segurança P0): esta linha continha uma
# connection string com host e senha reais de um projeto Supabase, commitada
# num arquivo que deveria ser só exemplo. Se esse valor já foi versionado em
# algum momento, a senha precisa ser rotacionada no painel do Supabase
# imediatamente (Project Settings → Database → Reset database password),
# e qualquer `.env` real que ainda a use precisa ser atualizado. O valor
# abaixo é só placeholder — nunca commitar aqui a string de produção.
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://redis:6379/0

# Segurança / JWT — gerar um valor forte em produção (nunca commitar o real).
JWT_SECRET_KEY=changeme-generate-a-strong-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Recuperação de senha
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
# URL base do frontend — usada para montar o link enviado por e-mail
# (ex.: {FRONTEND_URL}/redefinir-senha?token=...).
FRONTEND_URL=http://localhost:3000

# E-mail transacional
# console (padrão): não envia nada de verdade, apenas loga o e-mail — use em dev.
# smtp: envia de fato via SMTP (SES, Postmark, Resend, Mailgun, Gmail/Workspace...).
EMAIL_DRIVER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=no-reply@focopolicial.com.br
SMTP_FROM_NAME="Foco Policial"

# CORS — origens do frontend Next.js
CORS_ORIGINS=["http://localhost:3000"]

# Rate limiting
RATE_LIMIT_PER_MINUTE=60


# Adicionar ao final de .env.example (e ao seu .env local) —
# Worker de agregação de analytics, agendado in-process (ver app/core/scheduler.py)
ANALYTICS_AGGREGATOR_ENABLED=true
ANALYTICS_AGGREGATOR_INTERVAL_MINUTES=10
ANALYTICS_AGGREGATOR_DAILY_HOUR_UTC=3
ANALYTICS_AGGREGATOR_DAILY_WINDOW_DAYS=30

# Adicionar ao final de .env.example (e ao seu .env local) —
# Billing: driver de gateway de pagamento (ver app/services/billing/gateway.py)
# console (padrão): nenhum provedor real, aprova toda cobrança via ConsoleGateway.
# Usar apenas em desenvolvimento/teste.
PAYMENT_GATEWAY_DRIVER=console
# Segredo compartilhado com o provedor, usado para validar a assinatura do
# webhook (app/api/v1/billing/webhooks.py). Obrigatório em produção quando
# PAYMENT_GATEWAY_DRIVER != console — deixar vazio em desenvolvimento.
PAYMENT_WEBHOOK_SECRET=

# Rate limiting — políticas dedicadas (PROMPT 03)
# Adicionar ao final do bloco "# Rate limiting" já existente no .env.example
# real (que já tem RATE_LIMIT_PER_MINUTE=60).
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_MINUTE=5
RATE_LIMIT_FORGOT_PASSWORD_PER_MINUTE=3
RATE_LIMIT_RESET_PASSWORD_PER_MINUTE=5
RATE_LIMIT_BILLING_PER_MINUTE=20
RATE_LIMIT_FAIL_OPEN=true

SCHEDULER_ENABLED=true
SCHEDULER_LOCK_TTL_SECONDS=300