        PGEnum(
            SessionType,
            name="session_type",
            create_type=False,
            values_callable=lambda obj: [e.value for e in obj],
        ), nullable=False, index=True
    )
    session_id: Mapped[uuid.UUID] = mapped_column(UUID(as_uuid=True), nullable=False, index=True)
