{
  "family": "concurso-backend",
  "containerDefinitions": [
    {
      "name": "concurso-backend",
      "image": "240462142513.dkr.ecr.sa-east-1.amazonaws.com/concurso-backend:2fcecea",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "APP_ENV",
          "value": "production"
        },
        {
          "name": "ANALYTICS_AGGREGATOR_DAILY_HOUR_UTC",
          "value": "3"
        },
        {
          "name": "JWT_ALGORITHM",
          "value": "HS256"
        },
        {
          "name": "ACCESS_TOKEN_EXPIRE_MINUTES",
          "value": "15"
        },
        {
          "name": "ANALYTICS_AGGREGATOR_ENABLED",
          "value": "true"
        },
        {
          "name": "EMAIL_DRIVER",
          "value": "smtp"
        },
        {
          "name": "SMTP_HOST",
          "value": "email-smtp.sa-east-1.amazonaws.com"
        },
        {
          "name": "SMTP_PORT",
          "value": "587"
        },
        {
          "name": "SMTP_USE_TLS",
          "value": "true"
        },
        {
          "name": "SMTP_FROM_EMAIL",
          "value": "no-reply@alfacaveira.com"
        },
        {
          "name": "SMTP_FROM_NAME",
          "value": "Foco Policial"
        },
        {
          "name": "ANALYTICS_AGGREGATOR_INTERVAL_MINUTES",
          "value": "10"
        },
        {
          "name": "RATE_LIMIT_BILLING_PER_MINUTE",
          "value": "20"
        },
        {
          "name": "PAYMENT_GATEWAY_DRIVER",
          "value": "console"
        },
        {
          "name": "ANALYTICS_AGGREGATOR_DAILY_WINDOW_DAYS",
          "value": "30"
        },
        {
          "name": "REFRESH_TOKEN_EXPIRE_DAYS",
          "value": "30"
        },
        {
          "name": "CORS_ORIGINS",
          "value": "[\"https://main.dwzen9i9zuli0.amplifyapp.com\"]"
        },
        {
          "name": "DEBUG",
          "value": "false"
        },
        {
          "name": "RATE_LIMIT_PER_MINUTE",
          "value": "60"
        },
        {
          "name": "FRONTEND_URL",
          "value": "https://main.dwzen9i9zuli0.amplifyapp.com"
        },
        {
          "name": "RATE_LIMIT_REGISTER_PER_MINUTE",
          "value": "5"
        },
        {
          "name": "RATE_LIMIT_FORGOT_PASSWORD_PER_MINUTE",
          "value": "3"
        },
        {
          "name": "SCHEDULER_ENABLED",
          "value": "true"
        },
        {
          "name": "PASSWORD_RESET_TOKEN_EXPIRE_MINUTES",
          "value": "60"
        },
        {
          "name": "RATE_LIMIT_FAIL_OPEN",
          "value": "true"
        },
        {
          "name": "RATE_LIMIT_RESET_PASSWORD_PER_MINUTE",
          "value": "5"
        },
        {
          "name": "SCHEDULER_LOCK_TTL_SECONDS",
          "value": "300"
        },
        {
          "name": "RATE_LIMIT_LOGIN_PER_MINUTE",
          "value": "5"
        },
        {
          "name": "API_V1_PREFIX",
          "value": "/api/v1"
        }
      ],
      "mountPoints": [],
      "volumesFrom": [],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:sa-east-1:240462142513:secret:concurso/prod/database-url-iVjutA"
        },
        {
          "name": "JWT_SECRET_KEY",
          "valueFrom": "arn:aws:secretsmanager:sa-east-1:240462142513:secret:concurso/prod/jwt-secret-key-ClLLlb"
        },
        {
          "name": "REDIS_URL",
          "valueFrom": "arn:aws:secretsmanager:sa-east-1:240462142513:secret:concurso/prod/redis-url-Ryy7DI"
        },
        {
          "name": "SMTP_USER",
          "valueFrom": "arn:aws:secretsmanager:sa-east-1:240462142513:secret:concurso/prod/smtp-user-NTxU6w"
        },
        {
          "name": "SMTP_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:sa-east-1:240462142513:secret:concurso/prod/smtp-password-b864Sd"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/concurso-backend",
          "awslogs-region": "sa-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "systemControls": []
    }
  ],
  "taskRoleArn": "arn:aws:iam::240462142513:role/concurso-ecs-task-role",
  "executionRoleArn": "arn:aws:iam::240462142513:role/concurso-ecs-execution-role",
  "networkMode": "awsvpc",
  "volumes": [],
  "runtimePlatform": {
    "cpuArchitecture": "ARM64",
    "operatingSystemFamily": "LINUX"
  },
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512"
}
